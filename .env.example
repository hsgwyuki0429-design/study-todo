# 手元（Node）で MCP Server を動かすときの環境変数の見本。
# このファイルを .env としてコピーし、値を自分のものに置き換える。
# .env は .gitignore にあるので、GitHubへは上がらない。
#
#   node --env-file=.env server/adapters/node.js

# 管理キー。設定画面と管理APIだけで使う。AIへは渡さない。
# 16文字以上のランダムな文字列にする（例: openssl rand -hex 24）
STUDY_TODO_OWNER_KEY=ここに自分で作ったランダムな文字列

# study-todo（PWA）を置いている場所
STUDY_TODO_SITE_ORIGIN=https://hsgwyuki0429-design.github.io/study-todo

# 追加で通信を許すオリジン（カンマ区切り、省略可）
STUDY_TODO_ALLOWED_ORIGINS=http://localhost:8000

# 保存先のフォルダ（Nodeで動かすときだけ。既定は .study-todo-data）
# STUDY_TODO_DATA_DIR=.study-todo-data
